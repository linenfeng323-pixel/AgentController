<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="设置"
            android:textColor="@color/text_main"
            android:textSize="22sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_card_round"
            android:orientation="vertical"
            android:padding="14dp">

            <CheckBox
                android:id="@+id/cbAutoExec"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="自动执行 AI 返回的操作步骤"
                android:textColor="@color/text_main" />

            <CheckBox
                android:id="@+id/cbUseRoot"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="优先使用 Root 系统级执行"
                android:textColor="@color/text_main" />

            <CheckBox
                android:id="@+id/cbUseAcc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="启用无障碍兜底"
                android:textColor="@color/text_main" />

            <CheckBox
                android:id="@+id/cbShot"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="执行出错时自动截图"
                android:textColor="@color/text_main" />

            <CheckBox
                android:id="@+id/cbBridge"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="启用 PC/云端协同桥接"
                android:textColor="@color/text_main" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="PC 桥接地址"
            android:textColor="@color/text_sub"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/etBridgeUrl"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_search_bar"
            android:hint="ws://192.168.1.100:9912"
            android:inputType="textUri"
            android:padding="10dp"
            android:textColor="@color/text_main"
            android:textColorHint="@color/text_sub"
            android:textSize="13sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="代理循环最大步数"
            android:textColor="@color/text_sub"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/etMaxSteps"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_search_bar"
            android:inputType="number"
            android:padding="10dp"
            android:textColor="@color/text_main"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnSaveCfg"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:background="@drawable/bg_pill_accent"
                android:text="保存配置"
                android:textColor="@color/black"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnRestoreCfg"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_card_round"
                android:text="恢复原配置"
                android:textColor="@color/text_main" />
        </LinearLayout>

        <Button
            android:id="@+id/btnOpenOverlay"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card_round"
            android:text="开启悬浮窗权限"
            android:textColor="@color/text_main" />

        <!-- ===== GitHub 自动编译 ===== -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="GitHub 自动编译"
            android:textColor="@color/text_sub"
            android:textSize="12sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_card_round"
            android:orientation="vertical"
            android:padding="14dp">

            <CheckBox
                android:id="@+id/cbDeepThinking"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="默认启用深度思考"
                android:textColor="@color/text_main" />

            <CheckBox
                android:id="@+id/cbWebBrowsing"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="启用网页浏览工具"
                android:textColor="@color/text_main" />

            <CheckBox
                android:id="@+id/cbDeviceDirect"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="启用设备直达工具（闹钟/音量/媒体）"
                android:textColor="@color/text_main" />

            <CheckBox
                android:id="@+id/cbSensitiveRead"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="允许读取敏感设备信息（通知/短信/WiFi密码）"
                android:textColor="@color/text_main" />

            <CheckBox
                android:id="@+id/cbSensitiveOp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="允许敏感设备操作（发微信/冻结应用/改系统）"
                android:textColor="@color/text_main" />

            <CheckBox
                android:id="@+id/cbTerminal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="启用终端/文件工具（root shell + 文件读写）"
                android:textColor="@color/text_main" />

            <CheckBox
                android:id="@+id/cbLinuxEnv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Linux 工具环境（Python/Git/jq/zip 等）"
                android:textColor="@color/text_main" />

            <CheckBox
                android:id="@+id/cbMcp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="启用 MCP 服务器"
                android:textColor="@color/text_main" />

            <CheckBox
                android:id="@+id/cbContextSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="上下文总结"
                android:textColor="@color/text_main" />

            <CheckBox
                android:id="@+id/cbBgReview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="后台复盘"
                android:textColor="@color/text_main" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="GitHub Token (PAT)"
            android:textColor="@color/text_sub"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/etGithubToken"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_search_bar"
            android:hint="ghp_xxxxxxxx"
            android:inputType="textPassword"
            android:padding="10dp"
            android:textColor="@color/text_main"
            android:textColorHint="@color/text_sub"
            android:textSize="13sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="GitHub 仓库 (owner/repo)"
            android:textColor="@color/text_sub"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/etGithubRepo"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_search_bar"
            android:hint="linenfeng323-pixel/AgentController"
            android:inputType="text"
            android:padding="10dp"
            android:textColor="@color/text_main"
            android:textColorHint="@color/text_sub"
            android:textSize="13sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="分支名"
            android:textColor="@color/text_sub"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/etGithubBranch"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_search_bar"
            android:hint="main"
            android:inputType="text"
            android:padding="10dp"
            android:textColor="@color/text_main"
            android:textColorHint="@color/text_sub"
            android:textSize="13sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="主模型 URL（可空=用网页内置）"
            android:textColor="@color/text_sub"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/etMainModelUrl"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_search_bar"
            android:hint="https://api.example.com/v1"
            android:inputType="textUri"
            android:padding="10dp"
            android:textColor="@color/text_main"
            android:textColorHint="@color/text_sub"
            android:textSize="13sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="视觉模型 URL（可空）"
            android:textColor="@color/text_sub"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/etVisionModelUrl"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_search_bar"
            android:hint="https://api.example.com/vision"
            android:inputType="textUri"
            android:padding="10dp"
            android:textColor="@color/text_main"
            android:textColorHint="@color/text_sub"
            android:textSize="13sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="翻译模型 URL（可空）"
            android:textColor="@color/text_sub"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/etTranslateModelUrl"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_search_bar"
            android:hint="https://api.example.com/translate"
            android:inputType="textUri"
            android:padding="10dp"
            android:textColor="@color/text_main"
            android:textColorHint="@color/text_sub"
            android:textSize="13sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="推理模型 URL（可空）"
            android:textColor="@color/text_sub"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/etReasonModelUrl"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_search_bar"
            android:hint="https://api.example.com/reason"
            android:inputType="textUri"
            android:padding="10dp"
            android:textColor="@color/text_main"
            android:textColorHint="@color/text_sub"
            android:textSize="13sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="工作区目录"
            android:textColor="@color/text_sub"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/etWorkspaceDir"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_search_bar"
            android:hint="/storage/emulated/0/XINCODE"
            android:inputType="text"
            android:padding="10dp"
            android:textColor="@color/text_main"
            android:textColorHint="@color/text_sub"
            android:textSize="13sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="关于"
            android:textColor="@color/text_sub"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_card_round"
            android:padding="12dp"
            android:text="AI 操控盒子 v1.0\nRoot + 无障碍混合执行 / 代理循环 / 录制回放 / PC 协同\n借鉴白给 v19 防漏人缓存与自适应降频思路"
            android:textColor="@color/text_main"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
