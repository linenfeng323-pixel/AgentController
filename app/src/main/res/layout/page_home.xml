<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="AI 操控盒子"
        android:textColor="@color/text_main"
        android:textSize="26sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="搜索栏输入任意 AI 名称 / 网址，登录账号后即可让 AI 操控手机"
        android:textColor="@color/text_sub"
        android:textSize="13sp" />

    <!-- 搜索栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="20dp"
        android:background="@drawable/bg_search_bar"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="8dp">

        <EditText
            android:id="@+id/searchEdit"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@null"
            android:hint="@string/hint_search"
            android:imeOptions="actionGo"
            android:inputType="textUri|text"
            android:maxLines="1"
            android:textColor="@color/text_main"
            android:textColorHint="@color/text_sub"
            android:textSize="15sp" />

        <Button
            android:id="@+id/goButton"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_pill_accent"
            android:text="@string/btn_go"
            android:textColor="@color/black"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 热门 AI -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/hot_sites"
        android:textColor="@color/text_sub"
        android:textSize="13sp"
        android:textStyle="bold" />

    <!-- MCP 服务 快捷卡（对齐 agent-toolbox） -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_card_round"
        android:orientation="vertical"
        android:padding="14dp">

        <TextView
            android:id="@+id/mcpStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="⚪ MCP 服务未启动"
            android:textColor="@color/text_main"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="端口 8080 · JSON-RPC 2.0 · 40+ 工具 · SSE 流 · Python 3.14 · Git 三层回退"
            android:textColor="@color/text_sub"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnStartMcp"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_pill_accent"
                android:text="启动 MCP"
                android:textColor="@color/black"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnStopMcp"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_card_alt"
                android:text="停止"
                android:textColor="@color/text_main" />

            <Button
                android:id="@+id/btnOpenToolbox"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:background="@drawable/bg_card_alt"
                android:text="打开工具箱"
                android:textColor="@color/text_main" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnOpenDeepSeek"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_card_alt"
                android:text="DeepSeek 助手"
                android:textColor="@color/text_main" />

            <Button
                android:id="@+id/btnConnectMt"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:background="@drawable/bg_card_alt"
                android:text="连接 MT 管理器"
                android:textColor="@color/text_main" />
        </LinearLayout>
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/hotSitesGrid"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:nestedScrollingEnabled="false" />

    <!-- 最近 -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/recent_sites"
        android:textColor="@color/text_sub"
        android:textSize="13sp"
        android:textStyle="bold" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recentList"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:nestedScrollingEnabled="false" />

    <!-- 能力一览 -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="能力一览"
        android:textColor="@color/text_sub"
        android:textSize="13sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_card_round"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="4dp"
            android:text="• 任意 AI 一键接入：豆包 / DeepSeek / Kimi / 通义 / 文心 / 智谱 / 元宝 / ChatGPT / Claude / Gemini / Coze / 星火\n• 账号登录自动记忆，下次免登\n• Root 系统级操控：点击/滑动/输入/按键/启停 App/截图/设置/任意 shell\n• 无障碍兜底：按文字/ID 找节点点击、中文输入、手势\n• 自然语言下指令，AI 拆解为操作步骤并执行\n• 代理循环：观察-思考-行动，自适应降频防漏\n• 录制回放 / 命令历史 / 设备诊断 / 崩溃日志\n• PC/云端协同：WebSocket 长连接，会话粘连"
            android:textColor="@color/text_main"
            android:textSize="13sp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="24dp" />

    <!-- 底部状态条 -->
    <LinearLayout
        android:id="@+id/accessibilityBar"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_card_round"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <View
            android:id="@+id/statusDot"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:background="@drawable/bg_status_dot_off" />

        <TextView
            android:id="@+id/accessibilityStatus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:text="@string/accessibility_off"
            android:textColor="@color/text_main"
            android:textSize="12sp" />

        <Button
            android:id="@+id/openAccessibilityBtn"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:background="@drawable/bg_pill_accent"
            android:text="@string/btn_accessibility"
            android:textColor="@color/black"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
