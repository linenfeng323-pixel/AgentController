<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    tools:context=".MainActivity">

    <!-- 左侧 Mac 风格 Dock 边栏 -->
    <LinearLayout
        android:id="@+id/dock"
        android:layout_width="72dp"
        android:layout_height="0dp"
        android:background="@color/bg_card"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_launcher_foreground"
            android:background="@drawable/bg_fab"
            android:padding="6dp"
            android:contentDescription="logo" />

        <Space android:layout_width="1dp" android:layout_height="16dp" />

        <ImageButton
            android:id="@+id/navHome"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_nav_item"
            android:src="@drawable/ic_home"
            android:contentDescription="首页" />

        <ImageButton
            android:id="@+id/navAi"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_nav_item"
            android:src="@drawable/ic_robot"
            android:contentDescription="AI" />

        <ImageButton
            android:id="@+id/navRecord"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_nav_item"
            android:src="@drawable/ic_record"
            android:contentDescription="录制" />

        <ImageButton
            android:id="@+id/navDiagnose"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_nav_item"
            android:src="@drawable/ic_diagnose"
            android:contentDescription="诊断" />

        <ImageButton
            android:id="@+id/navSettings"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_nav_item"
            android:src="@drawable/ic_settings"
            android:contentDescription="设置" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/navLog"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_nav_item"
            android:src="@drawable/ic_log"
            android:contentDescription="日志" />
    </LinearLayout>

    <!-- 右侧主内容容器 -->
    <FrameLayout
        android:id="@+id/contentContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:padding="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/dock"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
