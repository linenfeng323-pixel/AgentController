<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@color/bg_card">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="对 AI 下达操控指令"
        android:textColor="@color/text_main"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="用自然语言描述你想让 AI 在手机上做的事，AI 会拆解为操作步骤并执行。"
        android:textColor="@color/text_sub"
        android:textSize="12sp" />

    <EditText
        android:id="@+id/cmdEdit"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_search_bar"
        android:gravity="top|start"
        android:hint="例如：打开微信，给张三发一条消息“明天见”"
        android:padding="12dp"
        android:textColor="@color/text_main"
        android:textColorHint="@color/text_sub"
        android:textSize="14sp" />

    <CheckBox
        android:id="@+id/autoExecCheck"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:checked="true"
        android:text="自动执行 AI 返回的操作步骤"
        android:textColor="@color/text_main" />
</LinearLayout>
